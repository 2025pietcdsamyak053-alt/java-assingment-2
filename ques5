import java.io.*;

interface Payment
{
    void makePayment(int amount);
    void paymentDetails();
}

class CreditCardPayment implements Payment
{
    String cardNumber, cardHolderName;
    int amount;

    CreditCardPayment(String cardNumber, String cardHolderName)
    {
        this.cardNumber = cardNumber;
        this.cardHolderName = cardHolderName;
    }

    public void makePayment(int amount)
    {
        this.amount = amount;
        System.out.println("Payment Successful!");
    }

    public void paymentDetails()
    {
        System.out.println("Payment Mode: Credit Card");
        System.out.println("Card Number: " + cardNumber);
        System.out.println("Card Holder: " + cardHolderName);
        System.out.println("Amount: Rs. " + amount);
    }
}

class UPIPayment implements Payment
{
    String upiId, userName;
    int amount;

    UPIPayment(String upiId, String userName)
    {
        this.upiId = upiId;
        this.userName = userName;
    }

    public void makePayment(int amount)
    {
        this.amount = amount;
        System.out.println("Payment Successful!");
    }

    public void paymentDetails()
    {
        System.out.println("Payment Mode: UPI");
        System.out.println("UPI ID: " + upiId);
        System.out.println("User Name: " + userName);
        System.out.println("Amount: Rs. " + amount);
    }
}

class CashPayment implements Payment
{
    String customerName;
    int amount;

    CashPayment(String customerName)
    {
        this.customerName = customerName;
    }

    public void makePayment(int amount)
    {
        this.amount = amount;
        System.out.println("Payment Successful!");
    }

    public void paymentDetails()
    {
        System.out.println("Payment Mode: Cash");
        System.out.println("Customer Name: " + customerName);
        System.out.println("Amount: Rs. " + amount);
    }
}

public class Main
{
    public static void main(String[] args) throws IOException
    {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        System.out.println("1. Credit Card");
        System.out.println("2. UPI");
        System.out.println("3. Cash");
        System.out.print("Enter Choice: ");

        int choice = Integer.parseInt(br.readLine());

        System.out.print("Enter Amount: ");
        int amount = Integer.parseInt(br.readLine());

        Payment p;

        if (choice == 1)
        {
            System.out.print("Enter Card Number: ");
            String card = br.readLine();

            System.out.print("Enter Card Holder Name: ");
            String name = br.readLine();

            p = new CreditCardPayment(card, name);
        }
        else if (choice == 2)
        {
            System.out.print("Enter UPI ID: ");
            String upi = br.readLine();

            System.out.print("Enter User Name: ");
            String name = br.readLine();

            p = new UPIPayment(upi, name);
        }
        else if (choice == 3)
        {
            System.out.print("Enter Customer Name: ");
            String name = br.readLine();

            p = new CashPayment(name);
        }
        else
        {
            System.out.println("Invalid Choice");
            return;
        }

        p.makePayment(amount);
        p.paymentDetails();
    }
