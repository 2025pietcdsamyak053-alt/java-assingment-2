import java.io.*;

abstract class Employee
{
    int employeeId;
    String employeeName;
    int basicSalary;

    Employee(int employeeId, String employeeName, int basicSalary)
    {
        this.employeeId = employeeId;
        this.employeeName = employeeName;
        this.basicSalary = basicSalary;
    }

    abstract int calculateSalary();

    void display()
    {
        System.out.println("Employee ID: " + employeeId);
        System.out.println("Employee Name: " + employeeName);
        System.out.println("Basic Salary: " + basicSalary);
        System.out.println("Salary: " + calculateSalary());
    }
}

class PermanentEmployee extends Employee
{
    PermanentEmployee(int employeeId, String employeeName, int basicSalary)
    {
        super(employeeId, employeeName, basicSalary);
    }

    int calculateSalary()
    {
        int hra = basicSalary * 20 / 100;
        int da = basicSalary * 40 / 100;
        int pf = basicSalary * 12 / 100;

        int grossSalary = basicSalary + hra + da;
        int netSalary = grossSalary - pf;

        return netSalary;
    }
}

class ContractEmployee extends Employee
{
    ContractEmployee(int employeeId, String employeeName, int basicSalary)
    {
        super(employeeId, employeeName, basicSalary);
    }

    int calculateSalary()
    {
        int allowance = basicSalary * 10 / 100;

        return basicSalary + allowance;
    }
}

 class Main
{
    public static void main(String[] args) throws IOException
    {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        System.out.print("Enter Permanent Employee ID: ");
        int id1 = Integer.parseInt(br.readLine());

        System.out.print("Enter Employee Name: ");
        String name1 = br.readLine();

        System.out.print("Enter Basic Salary: ");
        int salary1 = Integer.parseInt(br.readLine());

        Employee e1 = new PermanentEmployee(id1, name1, salary1);

        System.out.println("\nPermanent Employee");
        e1.display();

        System.out.print("\nEnter Contract Employee ID: ");
        int id2 = Integer.parseInt(br.readLine());

        System.out.print("Enter Employee Name: ");
        String name2 = br.readLine();

        System.out.print("Enter Basic Salary: ");
        int salary2 = Integer.parseInt(br.readLine());

        Employee e2 = new ContractEmployee(id2, name2, salary2);

        System.out.println("\nContract Employee");
        e2.display();
    }
}
